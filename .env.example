# Application
NODE_ENV=development
PORT=3030
JWT_SECRET=your-super-secret-key-at-least-32-chars-long
ENCRYPTION_KEY=your-super-secret-key-at-least-32-chars-long
BASE_URL=http://localhost:3030
APP_URL=http://localhost:3000

# Database
# When running via stack.testing.yml use the service name as host: postgres:5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/wrytes

# Redis (used for caching and BullMQ job queues)
# When running via stack.testing.yml use the service name as host: redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Optional — these are the defaults if omitted
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.2-vision:11b

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Alchemy
ALCHEMY_API_KEY=
# Required when MONITOR_MODE=webhook — shared secret from Alchemy dashboard
ALCHEMY_WEBHOOK_SECRET=

# 1inch API
ONEINCH_API_KEY=

# Wallet Configuration
WALLET_PRIVATE_KEY=

# Kraken API Configuration
KRAKEN_PUBLIC_KEY=
KRAKEN_PRIVATE_KEY=
KRAKEN_ADDRESS_KEY=
# Withdrawal key names registered bank accounts on Kraken
KRAKEN_CHF_WITHDRAW_KEY=
KRAKEN_EUR_WITHDRAW_KEY=

# Deribit API Configuration
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=
DERIBIT_BASE_URL=

# Off-ramp monitor
# MONITOR_MODE: "polling" (dev) or "webhook" (prod)
MONITOR_MODE=polling
MONITOR_POLL_INTERVAL_MS=60000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
